# Vercel
.vercel

# Environment variables — never commit
.env
.env.local
.env.*.local
.env.production

# Firebase service account credentials
*firebase-adminsdk*.json
**/serviceAccount*.json

# Node modules
node_modules/

# Build output
dist/
dist-ssr/

# Vite cache
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories and files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local data store (Vercel Blob is used in prod)
data/store.json
.env*

# Scratch / QA leftovers (unreferenced image candidates and backups)
.qa/
public/assets/welcome/candidates/
public/assets/**/*-prev.png
public/assets/**/*-prev-cleaned.png
public/assets/**/*-backup.png
