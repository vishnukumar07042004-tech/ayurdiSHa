# Copy to .env.local. Never use the VITE_ prefix (that exposes values in the browser).

# Staff passcode — server-only. Step 1 of "Staff access"; alone it never opens the staff area
# (an email code + admin approval follow). Use a long passphrase (12+ characters).
ADMIN_PIN=
# Admin email(s), comma-separated; auto-approved after passcode + email code. Default: the owner.
STAFF_ADMIN_EMAILS=
# Scripts' service token (Authorization: Bearer …), scoped allow-list only (not full admin).
# ≥ 32 chars: `openssl rand -hex 32`. Rotate after deploying the scoped-token change.
# Scripts read it as AYM_SERVICE_TOKEN (or this key from .env.local). Never print it.
STAFF_SERVICE_TOKEN=
# Optional Spark survival switch: 1 = lite mode (staff page cap 25; staffSnapshot paused).
# Turn on when whoami.quota.recommendLite is true or Firebase console shows ≥60% daily use.
# AYM_LITE_MODE=

# --- Registration OTP email (server-only) ---
# Option A — any SMTP account (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=you@gmail.com, SMTP_PASS=<16-char Gmail App Password from
#   https://myaccount.google.com/apppasswords — requires 2-step verification>).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B — Resend (https://resend.com): preferred primary for production volume.
# When both Resend and SMTP are set, Resend is tried first and Gmail/SMTP is fallback.
# Names only — set values on Vercel Production (Project → Settings → Environment Variables).
RESEND_API_KEY=
# Optional: resend | smtp | auto (default auto = Resend then SMTP).
MAIL_PROVIDER=
# Optional pretty sender, e.g. "AYURDISHA <no-reply@yourdomain.com>"
MAIL_FROM=
# Signs the pending-OTP httpOnly cookie so verify works across Vercel
# serverless instances (no shared disk); also signs staff sessions. Falls back to ADMIN_PIN if
# unset — set it (`openssl rand -hex 32`) so changing the passcode does not sign everyone out.
OTP_COOKIE_SECRET=
# If neither is set, OTPs are printed to the SERVER console only (dev fallback);
# they are never returned to the browser.

# --- Firestore (production store — priority 1 when set) ---
# Server-only Admin SDK credentials. Clients NEVER use these; see firestore.rules (deny all).
# Setup: https://console.firebase.google.com → new project → Firestore → service account key.
# On Vercel: add all three below to Production (and Preview if needed). Redeploy after setting.
# Verify: POST /api/aym-store {"op":"ping"} → "backend":"firestore"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste PEM with \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternatives (pick one approach — do not commit real values):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Local dev: drop JSON as serviceAccount.json or *firebase-adminsdk*.json in this folder (gitignored).

# --- Gemini AI (Knowledge journal search — server-only) ---
# Create at https://aistudio.google.com/apikey
# Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY → Production → Redeploy
# Without this key, search uses query-matched fallback sources (PubMed, WHO, Ayush, etc.)
GEMINI_API_KEY=

# --- OpenAI (Hybrid draft: GPT writes, Gemini checks — server-only) ---
# https://platform.openai.com/api-keys
# Vercel: Project → Settings → Environment Variables → OPENAI_API_KEY → Production → Redeploy
# Without this key the Hybrid card shows an error (or a marked Gemini fallback). It never publishes.
OPENAI_API_KEY=
# Optional. Blank uses gpt-5.4 for the Hybrid draft.
OPENAI_DRAFT_MODEL=
# OPENAI_DRAFT_TIMEOUT_MS=20000

# --- Vercel Blob (fallback store — priority 2) ---
# Used when Firebase creds are absent. Production today: ayurdisha/live-store.json
# Migrate to Firestore: node scripts/migrate-blob-to-firestore.js (see docs/DATA-STORAGE.md)
BLOB_READ_WRITE_TOKEN=

# --- Sign in with WAC ID (docs/wac-signin/WAC-SIGNIN-SPEC.md) ---
# list (default) = staff-uploaded WAC delegate list; api = WAC's verification API (needs both vars below)
WAC_VERIFY_MODE=list
# WAC_VERIFY_URL=https://<wac-host>/verify     POST {wacId, email} → {valid, name, email, phone, institution, category, country, state, attendance}
# WAC_VERIFY_KEY=                               sent as Authorization: Bearer <key>; never commit a real value
# WAC_ID_PATTERN=                               optional regex for the normalised ID once WAC confirms its format
# WAC_SIGNIN=off                                kill switch: hides the option and refuses the sign-in ops
